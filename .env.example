# Pick a model with the litellm "<provider>/<model>" prefix; the matching API key
# below is read automatically. See README.md "Choosing a model" for more options.
DELPHI_MODEL=anthropic/claude-opus-5

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# Ollama needs no API key, just a running local server (default http://localhost:11434).
# OLLAMA_API_BASE=http://localhost:11434

DELPHI_VAULT_DIR=./vault
# DELPHI_DB_PATH defaults to <DELPHI_VAULT_DIR>/.delphi/memory.db and moves with it.
# Only set this if you deliberately want the search index somewhere else — if you
# do, remember to update it too whenever you change DELPHI_VAULT_DIR, or note
# add/search will silently look at two different vaults.
# DELPHI_DB_PATH=./vault/.delphi/memory.db

# Lets Delphi see the screen and control the mouse/keyboard on this machine.
# Disabled unless set to exactly "1". Read README.md "Computer use" before enabling —
# this is real, unconfirmed control of whatever is running on this computer.
# DELPHI_ENABLE_COMPUTER_USE=1

# Enables `delphi chat --speak` (spoken responses via Chatterbox). Disabled unless
# set to exactly "1". Requires `pip install -e .[voice]` first — see README.md
# "Voice output".
# DELPHI_ENABLE_VOICE=1

# Lets Delphi run Python/shell commands and read/write files, scoped to a working
# directory. Disabled unless set to exactly "1". Read README.md "Writing & running
# code" before enabling — this is real, unconfirmed code execution.
# DELPHI_ENABLE_CODE=1
# Restricts DELPHI_ENABLE_CODE's file/shell access to this directory. Defaults to
# wherever you ran `delphi` from if unset.
# DELPHI_CODE_DIR=/path/to/a/project

# Lets Delphi read, edit, test, and - on your explicit approval - commit and
# restart itself into changes to its OWN source code. Disabled unless set to
# exactly "1". Read README.md "Self-improvement" before enabling.
# DELPHI_ENABLE_SELF_UPDATE=1

# Checks the git remote for new commits to Delphi itself and pulls+restarts
# automatically. On by default (fast-forward only, and only when the working
# tree is clean - it never overwrites local changes). Set to "0" to disable.
# DELPHI_ENABLE_AUTOUPDATE=1
# How often `delphi tray`/`delphi dashboard` poll for updates in the background,
# in seconds (minimum 60). `delphi chat` only checks once, at startup.
# DELPHI_AUTOUPDATE_INTERVAL=3600
