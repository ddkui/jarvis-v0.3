# Pick a model with the litellm "<provider>/<model>" prefix; the matching API key
# below is read automatically. See README.md "Choosing a model" for more options.
JARVIS_MODEL=anthropic/claude-opus-5

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# Ollama needs no API key, just a running local server (default http://localhost:11434).
# OLLAMA_API_BASE=http://localhost:11434

JARVIS_VAULT_DIR=./vault
JARVIS_DB_PATH=./vault/.jarvis/memory.db

# Lets Jarvis see the screen and control the mouse/keyboard on this machine.
# Disabled unless set to exactly "1". Read README.md "Computer use" before enabling —
# this is real, unconfirmed control of whatever is running on this computer.
# JARVIS_ENABLE_COMPUTER_USE=1

# Enables `jarvis chat --speak` (spoken responses via Chatterbox). Disabled unless
# set to exactly "1". Requires `pip install -e .[voice]` first — see README.md
# "Voice output".
# JARVIS_ENABLE_VOICE=1
